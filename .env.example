# =============================================================================
# MCP Weather Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control (it's already in .gitignore)
# =============================================================================

# QWeather API Host (provided by QWeather)
QWEATHER_API_HOST=https://your-api-host.qweatherapi.com

# JWT Key ID (from QWeather console)
KEY_ID=your-key-id-here

# Project ID (from QWeather console)
PROJECT_ID=your-project-id-here

# Private key path (relative to project root) - used by docker-run.sh
# PRIVATE_KEY_PATH=./keys/ed25519-private.pem
